# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#faf6f3"

# Main text color
theme[main_fg]="#221c18"

# Title color for boxes
theme[title]="#221c18"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff5a36"

# Background color of selected item in processes box. #221c18 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #fbf7f4 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#fbf7f4"

# Foreground color of selected item in processes box. Use #221c18 so
# the row text stays readable on the lighter_bg highlight; the previous
# #ff5a36 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#221c18"

# Color of inactive/disabled text
theme[inactive_fg]="#8c857f"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #433e3b caps at #ffffff when the foreground is already pure white, so we
# just bind it to #221c18 directly.
theme[graph_text]="#221c18"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #221c18 collapsed to the main fg.
theme[meter_bg]="#fbf7f4"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #564241 for a distinct accent instead of #433e3b which capped to white.
theme[proc_misc]="#564241"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#ad4e44"
theme[mem_box]="#7e2913"
theme[net_box]="#720000"
theme[proc_box]="#ff5a36"

# Box divider line and small boxes line color
theme[div_line]="#8c857f"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#7e2913"
theme[temp_mid]="#8b6000"
theme[temp_end]="#720000"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#564241"
theme[cpu_mid]="#3c342b"
theme[cpu_end]="#ad4e44"

# Mem/Disk free meter
theme[free_start]="#ad4e44"
theme[free_mid]="#3c342b"
theme[free_end]="#564241"

# Mem/Disk cached meter
theme[cached_start]="#3c342b"
theme[cached_mid]="#564241"
theme[cached_end]="#ad4e44"

# Mem/Disk available meter
theme[available_start]="#8b6000"
theme[available_mid]="#720000"
theme[available_end]="#720000"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#7e2913"
theme[used_mid]="#564241"
theme[used_end]="#3c342b"

# Download graph colors
theme[download_start]="#8b6000"
theme[download_mid]="#720000"
theme[download_end]="#720000"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#7e2913"
theme[upload_mid]="#564241"
theme[upload_end]="#3c342b"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#564241"
theme[process_mid]="#3c342b"
theme[process_end]="#ad4e44"
