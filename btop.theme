# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#0d0b09"

# Main text color
theme[main_fg]="#d7d3d0"

# Title color for boxes
theme[title]="#d7d3d0"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#ff5a36"

# Background color of selected item in processes box. #d7d3d0 maps to
# the foreground role in aether (terminal selection wants inverted contrast),
# which renders as plain white on dark themes - indistinguishable from the
# main text. #252322 gives a subtle highlight that still reads on a
# dark background and is invisible-but-harmless on light backgrounds.
theme[selected_bg]="#252322"

# Foreground color of selected item in processes box. Use #d7d3d0 so
# the row text stays readable on the lighter_bg highlight; the previous
# #ff5a36 produced low-contrast blue-on-white in dark themes.
theme[selected_fg]="#d7d3d0"

# Color of inactive/disabled text
theme[inactive_fg]="#827c77"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling.
# #dddad7 caps at #ffffff when the foreground is already pure white, so we
# just bind it to #d7d3d0 directly.
theme[graph_text]="#d7d3d0"

# Background color of the percentage meters. Same fix as selected_bg - the
# previous #d7d3d0 collapsed to the main fg.
theme[meter_bg]="#252322"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text.
# Use #b7a993 for a distinct accent instead of #dddad7 which capped to white.
theme[proc_misc]="#b7a993"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#f06400"
theme[mem_box]="#d57059"
theme[net_box]="#dc4506"
theme[proc_box]="#ff5a36"

# Box divider line and small boxes line color
theme[div_line]="#827c77"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="#d57059"
theme[temp_mid]="#ffb000"
theme[temp_end]="#dc4506"

# CPU graph colors (Teal -> Blue -> Purple)
theme[cpu_start]="#b7a993"
theme[cpu_mid]="#7d7969"
theme[cpu_end]="#f06400"

# Mem/Disk free meter
theme[free_start]="#f06400"
theme[free_mid]="#7d7969"
theme[free_end]="#b7a993"

# Mem/Disk cached meter
theme[cached_start]="#7d7969"
theme[cached_mid]="#b7a993"
theme[cached_end]="#f06400"

# Mem/Disk available meter
theme[available_start]="#ffb000"
theme[available_mid]="#dc4506"
theme[available_end]="#dc4506"

# Mem/Disk used meter (Green -> Teal -> Blue)
theme[used_start]="#d57059"
theme[used_mid]="#b7a993"
theme[used_end]="#7d7969"

# Download graph colors
theme[download_start]="#ffb000"
theme[download_mid]="#dc4506"
theme[download_end]="#dc4506"

# Upload graph colors (Green -> Teal -> Blue)
theme[upload_start]="#d57059"
theme[upload_mid]="#b7a993"
theme[upload_end]="#7d7969"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#b7a993"
theme[process_mid]="#7d7969"
theme[process_end]="#f06400"
